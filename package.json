{
  "name": "wedding-invitation-security-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:emulator": "node scripts/dev-server.mjs --emulator",
    "test": "node --test",
    "test:security": "firebase emulators:exec --only firestore --project demo-wedding-security \"node --test tests/event-settings-firestore.test.mjs tests/firestore-security.test.mjs tests/customer-access-firestore.test.mjs tests/customer-seating-batch-firestore.test.mjs tests/regressions-firestore.test.mjs tests/admin-platform-firestore.test.mjs tests/customer-isolation-firestore.test.mjs\"",
    "test:gender-reveal": "firebase emulators:exec --only auth,firestore --project demo-wedding-security \"node --test tests/gender-reveal-security.test.mjs\"",
    "test:provision": "firebase emulators:exec --only auth,firestore --project demo-wedding-security \"node --test tests/provision-admins.test.mjs\"",
    "seed:local": "node scripts/seed-local-access.mjs",
    "test:admin-api": "firebase emulators:exec --only auth,firestore --project demo-wedding-security \"node --test tests/admin-api-emulator.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "firebase": "12.19.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.7"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0"
  },
  "engines": {
    "node": "22.x"
  }
}
